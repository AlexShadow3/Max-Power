<Window x:Class="Connect4.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Max Power" Height="800" Width="818"
        Background="#2B2D42">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="BtnPVP" Content="Joueur vs Joueur" Width="150" Height="40" Margin="5" Click="BtnPVP_Click" 
                    Background="#8D99AE" Foreground="White" FontSize="16" FontWeight="Bold" BorderBrush="Transparent" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            <Button x:Name="BtnPVE" Content="Joueur vs Ordi" Width="150" Height="40" Margin="5" Click="BtnPVE_Click" 
                    Background="#8D99AE" Foreground="White" FontSize="16" FontWeight="Bold" BorderBrush="Transparent" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
        </StackPanel>

        <TextBlock x:Name="TxtStatus" Grid.Row="1" Text="Sélectionnez un mode de jeu" Foreground="White" FontSize="20" HorizontalAlignment="Center" Margin="10" FontWeight="Bold"/>

        <Border Grid.Row="2" Background="#1A535C" CornerRadius="10" Margin="20" Padding="10">
            <UniformGrid x:Name="GameGrid" Rows="6" Columns="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Ellipses will be added here dynamically -->
            </UniformGrid>
        </Border>
    </Grid>
</Window>
